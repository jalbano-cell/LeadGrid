VITE_GOOGLE_API_KEY=
VITE_GOOGLE_MAP_ID=
# Server-side only, no VITE_ prefix — never exposed to the browser. From tavily.com.
TAVILY_API_KEY=
# Server-side only. A separate Google API key from the one above, restricted to just
# Places API (New) with no application/referrer restriction (server calls can't send one).
# Falls back to VITE_GOOGLE_API_KEY if unset, but that key is referrer-restricted and won't
# actually work server-side — set this for Places search to work at all.
GOOGLE_PLACES_API_KEY=
