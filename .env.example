VITE_GOOGLE_API_KEY=
VITE_GOOGLE_MAP_ID=
# Server-side only, no VITE_ prefix — never exposed to the browser. From tavily.com.
TAVILY_API_KEY=
# Server-side only. A separate Google API key from the one above, with no application/referrer
# restriction (server calls can't send one) — restricted instead to just Places API (New) and
# Geocoding API. Falls back to VITE_GOOGLE_API_KEY if unset, but that key is referrer-restricted
# and won't actually work server-side — set this for Places search and the map's Location field
# (geocoding) to work at all.
GOOGLE_PLACES_API_KEY=

# Supabase — Project Settings > API. Both are safe to expose client-side (the anon key is meant
# to be public — every table is protected by RLS, "authenticated only"). Also read server-side by
# api/lib/requireAuth.js to validate the bearer token on the Places/socials/geocode proxies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
